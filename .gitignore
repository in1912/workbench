# ========== 运行时数据（数据库/用户数据/证书/发布包）==========
data/
*.sqlite
*.sqlite3
*.db
ssl/
*.eml

# ========== 前端：依赖与构建产物 ==========
node_modules/
dist/
# JARVIS 单模块应用的另一棵构建树（与 dist/ 一样不入库）
dist-sh/
build/
*.apk

# ========== 交付物：fpk / 分发包（不入 git，clean 前先挪走）==========
# 工作台的 fpk 例外（server/fnos/*.fpk 历来随 git 分发），JARVIS 这个按交付计划不入库：
# 它 27MB、且能从 fnos-sh/ 一行命令重打；放进来只会喂大仓库（public）与推送 blob
server/fnos-sh/*.fpk

# ========== Python ==========
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# ========== TTS 模型权重 / HF 缓存（可重新下载）==========
hf-cache/
tts/hf-cache/
tts/MOSS-TTS-Nano/
# 合成语音缓存（内容是用户要求的朗读文本 → 属个人数据，且可重新生成；2026-10-02 起不入库）
tts/cache/
tts/generated_audio/

# ========== 日志 ==========
Logs/
*.log

