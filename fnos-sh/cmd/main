#!/bin/bash
# 智能家居 fnOS 生命周期主脚本：start / stop / status
# 运行身份为包用户（见 config/privilege）；数据持久化在 @appdata（$TRIM_PKGVAR）。
#
# 与「全能工作台」那份 cmd/main 的两处实质差别：
#   ① 多注入 WB_MODE=smarthome —— server/index.js 见到它就走「独立应用模式」：
#      免登录（内置本地账号）、只挂智能家居相关路由、静态资源指向 web/dist-sh、端口默认 7778。
#   ② 不注入 DEFAULT_ADMIN / FNOS_AUTO_USER_PAGES —— 本应用没有登录页、没有开号流程，
#      内置账号由 db.ensureLocalUser() 自动建，这些环境变量在这儿没有意义。
APPDEST="${TRIM_APPDEST:-/var/apps/qgsmarthome/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/qgsmarthome/var}"
PKGETC="${TRIM_PKGETC:-/var/apps/qgsmarthome/etc}"
PORT="${TRIM_SERVICE_PORT:-7778}"
PID_FILE="$PKGVAR/smarthome.pid"
LOG_DIR="$PKGVAR/logs"
SOCK="$APPDEST/app.sock"

err_log() { [ -n "$TRIM_TEMP_LOGFILE" ] && echo "$1" > "$TRIM_TEMP_LOGFILE"; }

# fnOS Node 运行时（manifest install_dep_apps=nodejs_v22）；找不到时回退系统 PATH 的 node
NODE_BIN="/var/apps/nodejs_v22/target/bin/node"
[ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node || true)"
if [ -z "$NODE_BIN" ]; then
  err_log "未找到 Node.js：请确认应用中心已安装 nodejs_v22 运行时。"
  exit 1
fi

# node:sqlite 需 Node >= 22.5；22.5.0 ~ 22.12.x 还需 --experimental-sqlite 旗标，动态判断
NODE_FLAGS="--no-warnings"
NODE_VER="$("$NODE_BIN" -v | tr -d 'v')"          # 如 22.13.1
NODE_MAJOR="${NODE_VER%%.*}"
NODE_REST="${NODE_VER#*.}"; NODE_MINOR="${NODE_REST%%.*}"
if [ "$NODE_MAJOR" -eq 22 ] && [ "$NODE_MINOR" -lt 13 ]; then
  NODE_FLAGS="$NODE_FLAGS --experimental-sqlite"
fi

# 安装向导收集的配置（见 cmd/install_callback 写出的 etc/smarthome.env；本应用目前为空壳，
# source 一下让将来加配置项时不必改这段）
[ -f "$PKGETC/smarthome.env" ] && . "$PKGETC/smarthome.env"

pid_of() { [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null; }

case "$1" in
  start)
    mkdir -p "$PKGVAR/data" "$LOG_DIR"
    cd "$APPDEST" || { err_log "应用目录不存在：$APPDEST"; exit 1; }
    # 已在运行则不重复拉起（fnOS 重入式调用是正常的）
    OLD_PID="$(pid_of)"
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
      echo "智能家居已在运行（PID $OLD_PID）"; exit 0
    fi
    nohup env \
      WB_MODE="smarthome" \
      PORT="$PORT" \
      DATA_DIR="$PKGVAR/data" \
      DB_FILE="workbench.sqlite" \
      FNOS_APP_SOCK="$SOCK" \
      FNOS_PREFIX="/app/qgsmarthome" \
      TZ="${TZ:-Asia/Shanghai}" \
      "$NODE_BIN" $NODE_FLAGS server/index.js >> "$LOG_DIR/server.log" 2>&1 &
    echo $! > "$PID_FILE"
    echo "智能家居已启动（PID $(cat "$PID_FILE")，端口 $PORT，网关 $SOCK）"
    ;;

  status)
    PID="$(pid_of)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then exit 0; fi
    exit 3
    ;;

  stop)
    PID="$(pid_of)"
    if [ -z "$PID" ] || ! kill -0 "$PID" 2>/dev/null; then
      rm -f "$PID_FILE"; exit 0
    fi
    kill "$PID" 2>/dev/null
    for _ in $(seq 1 20); do    # 优雅退出最多等 10 秒
      kill -0 "$PID" 2>/dev/null || break
      sleep 0.5
    done
    kill -0 "$PID" 2>/dev/null && kill -9 "$PID" 2>/dev/null
    rm -f "$PID_FILE" "$SOCK"
    echo "智能家居已停止"
    ;;

  *)
    err_log "用法: main {start|stop|status}"
    exit 1
    ;;
esac
exit 0
